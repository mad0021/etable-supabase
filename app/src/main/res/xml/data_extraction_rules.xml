<?xml version="1.0" encoding="utf-8"?>
<!-- La sesión de Supabase y las preferencias no salen del dispositivo -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
